# Required origin and viewer authentication.
TUNNEL_ORIGIN=https://origin.example.com
TUNNEL_VIEWER_TOKEN=

# Use a Bunny secret and verify signatures at the origin.
TUNNEL_ORIGIN_SHARED_SECRET=

# Defaults shown here are the built-in defaults.
TUNNEL_ALLOWED_METHODS=GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS
TUNNEL_DENIED_PATH_PREFIXES=
TUNNEL_HEALTH_PATH=/__bunny_tunnel/healthz
TUNNEL_MAX_BODY_BYTES=10485760
TUNNEL_REQUEST_TIMEOUT_MS=30000
TUNNEL_PRESERVE_HOST_HEADER=false
TUNNEL_ALLOW_PUBLIC=false
TUNNEL_ALLOW_INSECURE_HTTP=false
TUNNEL_ALLOW_INSECURE_ORIGIN=false
