{
  "name": "@zimme/bunny-tunnel-edge-script",
  "version": "0.0.0",
  "exports": {
    ".": "./src/mod.ts"
  },
  "tasks": {
    "build": "deno run --allow-read --allow-write --allow-env --allow-run=deno ../../scripts/build_npm_package.ts .",
    "build:types": "deno run --allow-read --allow-write --allow-env npm:typescript@6.0.3/tsc --declaration --emitDeclarationOnly --outDir dist --rootDir src src/app.ts --module esnext --target esnext --lib esnext,dom --skipLibCheck",
    "check": "deno check src/app.ts src/mod.ts tests/app.test.ts",
    "smoke:package": "deno run --allow-read scripts/smoke_package.ts",
    "test": "deno test --allow-net=none tests"
  },
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      ".env.example",
      "src/app.ts",
      "src/mod.d.ts",
      "src/mod.ts"
    ]
  }
}
