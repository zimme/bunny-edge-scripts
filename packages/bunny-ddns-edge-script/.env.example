# Required Bunny Edge Script secrets. Values belong only in Bunny.
BUNNY_API_KEY=
DDNS_CLIENTS=
# DDNS_CLIENTS is a non-empty client JSON array; configure it privately.
# Every client needs a username, independent sharedSecrets, and explicit scope.
# See the runtime README; never save credential JSON in this repository.

# Optional safety controls. Deny lists always win.
DDNS_ALLOWED_HOSTS=
DDNS_DENIED_HOSTS=
DDNS_ALLOWED_ZONES=
DDNS_DENIED_ZONES=
# Set true only for intentionally account-wide global authority.
# A client also needs allowAllHosts=true to use that authority.
DDNS_ALLOW_ALL_HOSTS=false

# Defaults shown here are the built-in defaults.
DDNS_AUTO_CREATE=true
DDNS_TTL=900
DDNS_MULTI_RECORD_MODE=reject
DDNS_MAX_HOSTNAMES=25
DDNS_MAX_MUTATIONS=40
DDNS_RECORD_COMMENT=Managed by bunny-ddns-edge-script

# Mostly useful for tests or local API proxies.
DDNS_API_BASE_URL=https://api.bunny.net

# Local development only. Keep false in Bunny.
DDNS_ALLOW_INSECURE_HTTP=false
