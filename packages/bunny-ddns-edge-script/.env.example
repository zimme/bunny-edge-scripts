# Required Bunny Edge Script secrets.
BUNNY_API_KEY=
DDNS_SHARED_SECRET=

# Optional: comma-separated secrets for rotation. Overrides DDNS_SHARED_SECRET.
DDNS_SHARED_SECRETS=

# Optional: require a specific Basic Auth username as well as the shared secret.
DDNS_USERNAME=inadyn

# Optional safety controls. Deny lists always win.
DDNS_ALLOWED_HOSTS=
DDNS_DENIED_HOSTS=
DDNS_ALLOWED_ZONES=
DDNS_DENIED_ZONES=

# Defaults shown here are the built-in defaults.
DDNS_AUTO_CREATE=true
DDNS_TTL=900
DDNS_MULTI_RECORD_MODE=reject
DDNS_MAX_HOSTNAMES=25
DDNS_MAX_MUTATIONS=40
DDNS_RECORD_COMMENT=Managed by bunny-ddns-edge-script

# Mostly useful for tests or local API proxies.
DDNS_API_BASE_URL=https://api.bunny.net

# Local development only. Keep false in Bunny.
DDNS_ALLOW_INSECURE_HTTP=false
