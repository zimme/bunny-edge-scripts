{
  "name": "@zimme/create-bunny-ddns",
  "version": "0.0.0",
  "description": "Scaffold a Deno Bunny Edge Script repo that uses @zimme/bunny-ddns-edge-script.",
  "type": "module",
  "license": "MIT",
  "author": "zimme",
  "homepage": "https://github.com/zimme/bunny-edge-scripts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zimme/bunny-edge-scripts.git",
    "directory": "packages/create-bunny-ddns"
  },
  "bugs": {
    "url": "https://github.com/zimme/bunny-edge-scripts/issues"
  },
  "keywords": [
    "bunny.net",
    "bunny",
    "edge-script",
    "ddns",
    "dyndns",
    "deno",
    "create"
