    "ComVer",
    "denoland",
    "ddns",
    "dnserr",
    "dnszone",
    "DynDNS",
    "edgescript",
    "EnviromentalVariables",
    "healthz",
    "hostnames",
    "HOSTNAMES",
    "inadyn",
    "myip",
    "myip6",
    "nochg",
    "nohost",
    "notfqdn",
    "numhost",
    "zimme"
  ]
