{
  "version": "0.2",
  "language": "en",
  "useGitignore": true,
  "ignorePaths": [
    ".git",
    ".cspellcache",
    ".npm-cache",
    "dist",
    "examples/edge-script-repo/generated",
    "node_modules",
    "package-lock.json"
